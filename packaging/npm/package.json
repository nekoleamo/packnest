{
  "name": "packnest",
  "version": "0.0.0",
  "description": "国内网络开箱可用的多语言运行时安装器（node/npm/pnpm/bun/go/python）：Go 单二进制、零 CGO，内置国内镜像与自动探测。",
  "bin": {
    "pk": "bin/pk.js",
    "packnest": "bin/pk.js"
  },
  "optionalDependencies": {
    "@packnest/darwin-arm64": "0.0.0",
    "@packnest/darwin-x64": "0.0.0",
    "@packnest/linux-arm64": "0.0.0",
    "@packnest/linux-x64": "0.0.0",
    "@packnest/win32-arm64": "0.0.0",
    "@packnest/win32-x64": "0.0.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin/pk.js",
    "scripts/install.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "version-manager",
    "node",
    "mirror",
    "china",
    "pnpm",
    "bun",
    "go"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nekoleamo/packnest"
  }
}
